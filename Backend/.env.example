DATABASE_URL=postgresql+psycopg://travelly_app:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/travelly_dev
# Use a dedicated Redis database; local loopback development may use redis://.
# Production requires rediss:// with authentication, AOF and noeviction.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_SECRET
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENVIRONMENT=development
# Provision offline first. Keep these separate and outside the repository/webroot.
PRIVATE_DOCUMENT_ROOT=D:/TravellyData/private-documents
REVIEW_AUDIT_ROOT=D:/TravellyData/review-audit
# Independent UUID for this database/restore lineage; never reuse after an unrelated restore.
REVIEW_DATABASE_IDENTITY=REPLACE_WITH_INDEPENDENT_DEPLOYMENT_UUID
# Isolated local writer IPC. Run app.review_writer under the restricted writer identity.
REVIEW_AUDIT_ENDPOINT=\\.\pipe\TravellyReviewAudit-local
REVIEW_AUDIT_AUTH_FILE=D:/TravellyData/review-client/pipe.key
# Tests isolate their data in a random PostgreSQL schema inside travelly_dev,
# using travelly_app, and use a random Redis namespace (never FLUSHDB).
# Local development uses Mailpit (loopback only); capture remains available for isolated tests.
FRONTEND_URL=http://127.0.0.1:5173
MAIL_BACKEND=mailpit
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
# When MAIL_BACKEND=capture, the default directory is the OS temp directory / travelly-mail.
# MAIL_CAPTURE_DIR=C:/private/travelly-mail
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_DAILY_LIMIT=250
# Production must use Brevo; keep its private API key only in the production secret store.
BREVO_API_KEY=
GOOGLE_CLIENT_ID=
# openrouteservice geocoding/directions; credentials stay server-side.
# Leave empty to fail closed for live routing, while local example previews remain usable.
ROUTING_API_KEY=
# HeiGIT moved openrouteservice to api.heigit.org (old host shut down 2-6 Nov 2026). Same key; no trailing slash.
ROUTING_BASE_URL=https://api.heigit.org
# Separate operator-provisioned moderated photo store, outside repository/webroot/private roots.
# VEHICLE_PHOTO_ROOT=C:/private/travelly-vehicle-photos
# PayHere (sandbox.payhere.lk now, live later). Leave all three empty to offer only the built-in Sandbox.
# Merchant ID: PayHere > Integrations. Merchant Secret: Integrations > Add Domain/App (one secret per domain).
# Never commit real values; keep them only in Backend/.env.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
# PayHere Refund API (Settings > API Keys, permission "Automatic Charging API"); empty = refunds stay manual
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
# Public HTTPS address of this API so PayHere can post payment notices (for example your ngrok URL, no trailing slash).
PUBLIC_API_URL=

# Reminders job (Backend/scripts/send_reminders.py, run daily by Task Scheduler or cron)
# Document expiry warning window in working days (PRD default 5); also used for "maintenance due soon".
REMINDER_WORKING_DAYS=5
# Email copies of reminders: keep false until real email delivery (MAIL_BACKEND=brevo) is configured.
REMINDER_EMAIL_ENABLED=false

# Road alerts (owner decisions 12 Nov 2026): minutes an alert stays up per type, and the relevance radius
ROAD_ALERT_MINUTES_POLICE_PRESENCE=60
ROAD_ALERT_MINUTES_SPEED_CHECK=60
ROAD_ALERT_MINUTES_ACCIDENT=120
ROAD_ALERT_MINUTES_ROAD_HAZARD=120
ROAD_ALERT_MINUTES_ROADBLOCK=180
ROAD_ALERT_RADIUS_KM=15
ROAD_ALERT_CONFIRM_SECONDS=10
# Odometer photo proof at trip start and finish. Photos are kept this many days after the trip, then deleted.
# Folder default: next to PRIVATE_DOCUMENT_ROOT (for example D:/TravellyData/odometer-photos).
ODOMETER_PHOTO_REQUIRED=true
ODOMETER_PHOTO_KEEP_DAYS=7
# ODOMETER_PHOTO_ROOT=D:/TravellyData/odometer-photos
# Travel Reels: video length and size limits; media folder default next to PRIVATE_DOCUMENT_ROOT (social-media).
SOCIAL_REEL_MAX_SECONDS=60
SOCIAL_REEL_MAX_MB=50
# SOCIAL_MEDIA_ROOT=D:/TravellyData/social-media
# Travelly AI (smart search + help). Free key from Google AI Studio (aistudio.google.com > Get API key).
# Leave empty to use the built-in rules only. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_LIMIT=200
