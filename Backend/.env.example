DATABASE_URL=postgresql+psycopg://travelly_app:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/travelly_dev
# Use a dedicated Redis database; local loopback development may use redis://.
# Production requires rediss:// with authentication, AOF and noeviction.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_SECRET
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENVIRONMENT=development
# Provision offline first. Keep these separate and outside the repository/webroot.
PRIVATE_DOCUMENT_ROOT=D:/TravellyData/private-documents
REVIEW_AUDIT_ROOT=D:/TravellyData/review-audit
# Independent UUID for this database/restore lineage; never reuse after an unrelated restore.
REVIEW_DATABASE_IDENTITY=REPLACE_WITH_INDEPENDENT_DEPLOYMENT_UUID
# Isolated local writer IPC. Run app.review_writer under the restricted writer identity.
REVIEW_AUDIT_ENDPOINT=\\.\pipe\TravellyReviewAudit-local
REVIEW_AUDIT_AUTH_FILE=D:/TravellyData/review-client/pipe.key
# Tests isolate their data in a random PostgreSQL schema inside travelly_dev,
# using travelly_app, and use a random Redis namespace (never FLUSHDB).
# Auth extension: local capture sends no external email. Never put real keys in this example.
FRONTEND_URL=http://127.0.0.1:5173
MAIL_BACKEND=capture
# Default capture directory: the operating-system temp directory / travelly-mail.
# MAIL_CAPTURE_DIR=C:/private/travelly-mail
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_DAILY_LIMIT=250
BREVO_API_KEY=
GOOGLE_CLIENT_ID=
