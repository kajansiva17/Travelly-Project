/* Shared scale for Home, For Drivers and For Owners. ONE set of tokens drives the hero on all three pages, so the gap under the
   navbar, the heading, subtext and button sizes cannot drift apart. The navbar itself is the same component and the same frame.css
   tokens on every page. Imported last. (@G is expanded to a high-specificity prefix so these rules beat the older per-page layers.) */
.lr-page {
  --frame-inset-x: var(--lr-gutter);                                  /* navbar, hero text and sections share one left/right edge */
  --frame-w: min(calc(100% - 2 * var(--frame-inset-x)), var(--frame-max));
  --lr-edge: calc((100% - var(--frame-w)) / 2);
  --lr-hero-gap: clamp(28px, 7vh, 72px);                              /* navbar bottom -> hero heading */
  --lr-h1: clamp(32px, 6.6vh, 60px);
  --lr-sub: clamp(16px, 2.9vh, 24px);
  --lr-btn-h: clamp(40px, 5.6vh, 50px);
  --lr-btn-fs: clamp(15px, 2.3vh, 18px);
}

/* ---- hero: exactly one viewport, same box and type scale on every page ---- */
@G .lr-hero {
  display: flex; flex-direction: column; box-sizing: border-box; gap: 0; height: auto; min-height: 100dvh;
  padding: calc(var(--lr-header-bottom, 68px) + var(--lr-hero-gap)) var(--lr-edge) clamp(10px, 2.6vh, 28px);
}
@G .lr-hero-copy { width: min(560px, 100%); max-width: 100%; margin: 0; padding: 0; }
@G .lr-hero h1 { max-width: none; font-size: var(--lr-h1); line-height: 1.06; letter-spacing: -.03em; font-weight: 800; }
html:not([lang=en]) @G .lr-hero h1 { font-size: calc(var(--lr-h1) * .86); line-height: 1.3; letter-spacing: 0; }
@G .lr-description { max-width: 420px; margin: clamp(6px, 1.4vh, 14px) 0 0 !important; font-size: var(--lr-sub); line-height: 1.3; font-weight: 600; letter-spacing: -.01em; }
html:not([lang=en]) @G .lr-description { font-size: calc(var(--lr-sub) * .88); line-height: 1.5; }
@G .lr-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: clamp(12px, 2.6vh, 24px); }
@G .lr-hero-actions .lr-pill { min-height: var(--lr-btn-h); padding: 0 clamp(16px, 1.8vw, 26px); font-size: var(--lr-btn-fs); font-weight: 700; gap: 10px; line-height: 1.2; }
@G .lr-hero-actions .lr-pill svg { width: 20px; height: 20px; }
@G .lr-hero-helper { max-width: 440px; margin: clamp(8px, 1.4vh, 12px) 0 0 !important; font-size: clamp(13px, 1.9vh, 16px); font-weight: 600; line-height: 1.4; }
@G .lr-content { padding-top: 0; }

/* ---- the strip under the steps is a normal section now (it has a heading); keep it flush with its neighbours ---- */
@G .lr-content > .lr-features-section { margin: 0; }

/* ---- buttons: Sign up is the only solid red; every other red control is light glass with red text and icon ---- */
@G :is(.lr-red, .lr-active):not(.lr-signup) {
  background: rgb(255 255 255 / .6) !important; color: var(--brand-red) !important; text-shadow: none;
  border: 1px solid var(--brand-red-border) !important;
  box-shadow: 0 6px 16px rgb(18 40 90 / .14), inset 0 1px 0 rgb(255 255 255 / .85) !important;
  -webkit-backdrop-filter: blur(14px) saturate(1.3); backdrop-filter: blur(14px) saturate(1.3);
  transition: background-color .15s, box-shadow .15s, transform .15s;
}
@G :is(.lr-red, .lr-active):not(.lr-signup):hover { background: rgb(255 255 255 / .85) !important; box-shadow: 0 8px 20px var(--brand-red-shadow), inset 0 1px 0 #fff !important; transform: translateY(-1px); }
@G :is(.lr-red, .lr-active):not(.lr-signup):focus-visible { outline: 3px solid var(--brand-red); outline-offset: 3px; }
@G :is(.lr-red, .lr-active):not(.lr-signup):is(:disabled, [aria-disabled="true"]) { opacity: .55; transform: none; box-shadow: none !important; cursor: default; }
@G .lr-signup { background: var(--brand-red-gradient) !important; color: #fff !important; border: 1px solid rgb(255 255 255 / .85) !important; box-shadow: 0 5px 12px var(--brand-red-shadow), inset 0 0 6px rgb(255 255 255 / .7) !important; }
@G .lr-signup:hover { box-shadow: 0 7px 16px var(--brand-red-shadow), inset 0 0 6px #fff !important; }
@G .lr-signup:focus-visible { outline: 3px solid var(--brand-red); outline-offset: 3px; }
/* role icons in the navbar take the text colour (red when the pill is active) */
@G .lr-role-icon { background: currentColor; -webkit-mask: var(--lr-role-icon) center / contain no-repeat; mask: var(--lr-role-icon) center / contain no-repeat; filter: none; }
@G .lr-active .lr-role-icon { filter: none; }
@media (prefers-reduced-motion: reduce) { @G :is(.lr-red, .lr-active):not(.lr-signup) { transition: none; } }

/* ---- footer: the navbar brand (NavbarBrand) at the navbar's logo width, same side edges as the page ---- */
@G .lr-footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 88px; padding: 16px var(--lr-edge); }
@G .lr-footer-brand { display: flex; flex: 0 0 auto; align-items: center; }
@G .lr-footer .lr-footer-brand .brand.travelly-brand { width: var(--nav-logo-w); }
@G .lr-footer nav > :first-child { min-width: 104px; padding-left: 22px; }

/* ---- phones ---- */
@media (max-width: 760px) {
  @G .lr-hero { padding-bottom: 0; }
  @G.lr-driver .lr-hero-art, @G.lr-owner .lr-hero-art { position: relative; inset: auto; flex: 1 1 auto; min-height: 230px; height: auto; margin: 16px calc(-1 * var(--lr-edge)) 0; width: auto; }
  @G.lr-home .lr-hero { padding-bottom: 16px; }
  @G .lr-footer { flex-direction: column; justify-content: center; gap: 12px; }
}
